# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.
# Only public values go here: anything starting with VITE_ ends up in the browser.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# From contracts/ after `npm run deploy:base-sepolia`
VITE_VAULT_ADDRESS=
VITE_CHAIN=base-sepolia
