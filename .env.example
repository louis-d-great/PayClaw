# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.
# Only public values go here: anything starting with VITE_ ends up in the browser.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# From contracts/ after `npm run deploy:tempo-testnet` (the current testnet vault is below)
VITE_VAULT_ADDRESS=0xCEb2e939DE06360eB2fE68e07A2589059d9CAc2A
VITE_CHAIN=tempo-testnet
