# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.
# Only public values go here: anything starting with VITE_ ends up in the browser.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# From contracts/ after `npm run deploy:tempo-testnet` (the current testnet vault is below)
VITE_VAULT_ADDRESS=0xCEb2e939DE06360eB2fE68e07A2589059d9CAc2A
VITE_CHAIN=tempo-testnet

# Server only (never VITE_). Set these in Vercel too.
# The wallet that pays users' network fees on Tempo.
FEE_PAYER_PRIVATE_KEY=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Bypasses security rules.
SUPABASE_SERVICE_ROLE_KEY=
# The dispute reviewer: the vault's reviewer key, and which CrewPay handles may open /review.
REVIEWER_PRIVATE_KEY=
REVIEWER_HANDLES=

# Email updates (server only; set in Vercel too). See docs/SETUP.md, section 4.
NOTIFY_SECRET=
APP_URL=https://payclaw-six.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
